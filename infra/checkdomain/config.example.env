# Copy to infra/checkdomain/config.env and chmod 0600.
# Never commit config.env. Never put passwords on CLI argv.

CHECKDOMAIN_HOST=host275.checkdomain.de
CHECKDOMAIN_USER=thwhvklj
CHECKDOMAIN_REMOTE_BASE=/var/www/vhosts/thwhvklj.host275.checkdomain.de/deintarifheld.de
CHECKDOMAIN_PROTOCOL=sftp
CHECKDOMAIN_LOCAL_OUT=./out
CHECKDOMAIN_BACKUP_ROOT=
# Absolute path to SSH private key for BatchMode SFTP (preferred).
CHECKDOMAIN_SSH_IDENTITY=
CHECKDOMAIN_VERIFY_BASE=https://www.deintarifheld.de

# Operational mail gate (server-side truth; not baked into static HTML)
LEADS_MAIL_MODE=mock
# Explicit ops override only — never auto-set in scripts
ALLOW_MOCK_MAIL_CUTOVER=NO
