# --- DeinTarifheld Leads Phase A (Vercel + Supabase + Resend) ---
# Copy to .env.local for local API tests. Never commit real secrets.

# Supabase (service role = server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# After deintarifheld.de is verified in Resend, use the domain addresses below.
# Until then Resend only delivers to the Resend account inbox (not kontakt@).
LEADS_FROM_EMAIL=DeinTarifheld <kontakt@deintarifheld.de>
# Comma-separated allowed. Unverified domains cannot receive here.
LEADS_TO_EMAIL=kontakt@deintarifheld.de
# mock | fail | internal_live | live
# safe default = mock
# internal_live = temporary internal Resend notify only (no customer confirmation)
# live = internal + customer confirmation ONLY if ALLOW_CUSTOMER_MAIL=YES
LEADS_MAIL_MODE=mock
# Dual guard for customer mail. Must be YES together with LEADS_MAIL_MODE=live.
# Leave unset / NO until Legal + ops explicitly enable customer confirmation.
ALLOW_CUSTOMER_MAIL=NO

# reCAPTCHA — Standard v2/v3 + classic siteverify ONLY.
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY is NOT a supported production variant.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=     # v2 checkbox
# NEXT_PUBLIC_RECAPTCHA_PUBLIC_KEY=   # v3 execute
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_ALLOWED_HOSTNAMES=
# Separate salt for delete-audit email HMAC (never reuse LEADS_RATE_LIMIT_SALT)
# AUDIT_EMAIL_HASH_SALT=

# Automation secrets — production minimum 32 chars, fail-closed if weak
CRON_SECRET=
LEADS_ADMIN_SECRET=
# Ops inbox (Vercel API only — not on the public Checkdomain site):
# https://deintarifheld-leads-api.vercel.app/api/admin/inbox/
# Production: set an unpredictable salt. Historic default is not used in production.
LEADS_RATE_LIMIT_SALT=
# memory (local/CI) | supabase (production default when VERCEL_ENV=production)
# LEADS_RATE_LIMIT_PROVIDER=supabase
# Explicit residual-risk accept only (never the silent production default):
# LEADS_ALLOW_MEMORY_RATE_LIMIT=YES

# CI/preview intake without Origin. Disabled in production even if set.
# LEADS_ALLOW_SMOKE_BYPASS=YES
# LEADS_INTAKE_SMOKE_SECRET=

# Force production fail-closed locally (do not set on CI):
# LEADS_RUNTIME_ENV=production

# Exact origins only (comma-separated). No wildcards.
# localhost entries are ignored when VERCEL_ENV or LEADS_RUNTIME_ENV is production.
LEADS_ALLOWED_ORIGINS=https://deintarifheld.de,https://www.deintarifheld.de

# Frontend (static Checkdomain build): canonical API origin (no path, no trailing slash required)
# Production example:
# NEXT_PUBLIC_LEADS_API_ORIGIN=https://deintarifheld-leads-api.vercel.app
# Legacy alias (origin OR full .../api/leads[/] URL) — prefer ORIGIN above
# NEXT_PUBLIC_LEADS_API_URL=https://deintarifheld-leads-api.vercel.app/api/leads/

# Retention (days) — LEGAL_REVIEW_REQUIRED for published legal texts
# LEADS_RETENTION_DAYS=90
# LEADS_PRIVATE_RETENTION_DAYS=90
# LEADS_CAREER_RETENTION_DAYS=183

# Static Checkdomain build only:
# STATIC_EXPORT=1

# Controlled smoke recipient (infra automation)
# CONTROLLED_TEST_EMAIL=

# Checkdomain DNS API v1 (infra automation — use infra/phase-a/config.env)
# CHECKDOMAIN_API_BASE_URL=https://api.checkdomain.de
# CHECKDOMAIN_API_TOKEN=
# CHECKDOMAIN_DOMAIN_NAME=deintarifheld.de
