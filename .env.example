# --- DeinTarifheld Leads Phase A (Vercel + Supabase + Resend) ---
# Copy to .env.local for local API tests. Never commit real secrets.

# Supabase (service role = server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
LEADS_FROM_EMAIL=DeinTarifheld <kontakt@deintarifheld.de>
LEADS_TO_EMAIL=kontakt@deintarifheld.de
# mock | fail | internal_live | live
# safe default = mock
# internal_live = temporary internal Resend notify only (no customer confirmation)
# live = internal + customer confirmation (explicit ops only; needs verified domain)
LEADS_MAIL_MODE=mock

# Automation secrets
CRON_SECRET=
LEADS_ADMIN_SECRET=
LEADS_RATE_LIMIT_SALT=

# Exact origins only (comma-separated). No wildcards.
LEADS_ALLOWED_ORIGINS=https://deintarifheld.de,https://www.deintarifheld.de,http://localhost:3000

# Frontend (static Checkdomain build): canonical API origin (no path, no trailing slash required)
# Production example:
# NEXT_PUBLIC_LEADS_API_ORIGIN=https://deintarifheld-leads-api.vercel.app
# Legacy alias (origin OR full .../api/leads[/] URL) — prefer ORIGIN above
# NEXT_PUBLIC_LEADS_API_URL=https://deintarifheld-leads-api.vercel.app/api/leads/

# Retention (days) — LEGAL_REVIEW_REQUIRED for published legal texts
# LEADS_RETENTION_DAYS=90
# LEADS_PRIVATE_RETENTION_DAYS=90
# LEADS_CAREER_RETENTION_DAYS=183

# Static Checkdomain build only:
# STATIC_EXPORT=1

# Controlled smoke recipient (infra automation)
# CONTROLLED_TEST_EMAIL=

# --- P4-H0b3b local CC passkey gate (Development only; never commit real values) ---
# DTH_CC_LOCAL_UI_ENABLED=true
# DTH_CC_PASSKEY_GATE_ENABLED=true
# DTH_CLERK_PUBLISHABLE_KEY=
# DTH_CLERK_FAPI_URL=https://sterling-husky-22.clerk.accounts.dev

# --- M11P Hosted Command Center (staging only) ---
# DTH_AUTH_MODE=hosted
# NEXT_PUBLIC_SUPABASE_URL=https://uunpbmfvbfkideylhtbl.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DTH_STAGING_OPS_DATABASE_URL=

# Checkdomain DNS API v1 (infra automation — use infra/phase-a/config.env)
# CHECKDOMAIN_API_BASE_URL=https://api.checkdomain.de
# CHECKDOMAIN_API_TOKEN=
# CHECKDOMAIN_DOMAIN_NAME=deintarifheld.de
